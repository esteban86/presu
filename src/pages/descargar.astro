---
// /descargar — la descarga está apagada mientras la waitlist está abierta.
// Redirige a la lista de espera. Los instaladores directos del worker
// `presu-ai` siguen vivos; esto solo saca la descarga del sitio.
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Presu — lista de espera</title>
    <link rel="canonical" href="https://presu.io/" />
    <meta http-equiv="refresh" content="0; url=/#waitlist" />
    <script is:inline>location.replace('/#waitlist');</script>
    <style>
      html,body{margin:0;height:100%}
      body{background:#08080A;color:#F4F4F3;font-family:system-ui,-apple-system,"Hanken Grotesk",sans-serif;display:grid;place-items:center;text-align:center;padding:24px;line-height:1.6}
      a{color:#34D399;font-weight:700}
    </style>
  </head>
  <body>
    <p>Te llevamos a la lista de espera… <a href="/#waitlist">Entrar ahora →</a></p>
  </body>
</html>
