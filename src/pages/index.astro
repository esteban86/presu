---
// index.astro — la portada que vende (spec «presu.io que vende», #39, §6.1).
// Orden: hero (el dolor, la promesa, el video y la lista) → el dolor → tres verbos,
// cada uno con un momento animado de la app → tus datos son tuyos → Familia → lo que te
// llevas por entrar ahora → preguntas → la lista otra vez.
//
// Sin precios (CA8) y con UNA sola acción: el formulario de la lista (CA14).
// Toda frase que afirma algo de la app lleva `data-afirma` y vive primero en
// `src/data/afirmaciones.json`, con la línea de la app que la prueba (CA4).
//
// Los momentos (`src/components/momentos/`) están hechos en código, con las cifras de la base
// de demostración (`src/data/momentos.json` y `cifras-de-la-demo.json`, que escribe
// `scripts/actualizar-datos-de-la-demo.mjs`). El video (Tarea 9) todavía no existe: en su
// lugar va un hueco marcado (`.hueco-vsl`), que esa tarea reemplaza por `Vsl`.
//
// El markup del hero conserva el contrato de DOM de los scripts de la lista:
// #hero-form + #hero-email + #hero-err + #hero-ok, #waitlist-form, .proof .count.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import FaqItem from '../components/ui/FaqItem.astro';
import MomentoEntraSolo from '../components/momentos/MomentoEntraSolo.astro';
import MomentoComoVas from '../components/momentos/MomentoComoVas.astro';
import MomentoQueViene from '../components/momentos/MomentoQueViene.astro';
import homeJsonLd from '../data/home-jsonld.json';
import afirmaciones from '../data/afirmaciones.json';

// Turnstile: solo se renderiza si hay site key (build-time). Sin ella, el widget
// no aparece y el worker no exige token (rollout inerte hasta provisionar).
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

// El texto de cada afirmación sale del inventario: así la página no puede decir
// una cosa y el inventario otra.
const porId = new Map(afirmaciones.afirmaciones.map((a) => [a.id, a.texto]));
const t = (id: string): string => {
  const texto = porId.get(id);
  if (!texto) throw new Error(`falta la afirmación «${id}» en afirmaciones.json`);
  return texto;
};

// 2 · El dolor, en palabras de la persona. No afirma nada de la app.
const dolores = [
  {
    titulo: 'Llega fin de mes y no cuadra',
    texto: 'Te pagan, pagas, y a los pocos días ya no sabes en qué se te fue la plata.',
  },
  {
    titulo: 'Pagas las tarjetas y no te sobra',
    texto: 'El extracto llega, lo pagas, y vuelves a empezar el mes corto.',
  },
  {
    titulo: '¿Me alcanza para este gusto?',
    texto: 'No sabes si te lo puedes dar. O te lo das y después te das cuenta de que no debías.',
  },
  {
    titulo: 'Anotar todo a mano no dura',
    texto: 'La planilla aguanta dos semanas. Y la cuenta, la tarjeta y la otra tarjeta viven en apps distintas.',
  },
];

// 3 · Tres verbos como prueba, cada uno con UN momento de la app, animado y hecho en código
// (`src/components/momentos/`): un iPhone, un Mac y otro iPhone.
const verbos = [
  {
    n: '1',
    titulo: 'Entra solo',
    afirma: ['entra-correo', 'entra-sms', 'entra-extracto'],
    // En vez de dos pantallazos, un momento animado: llega un aviso del banco y se vuelve un
    // movimiento ya con su categoría (`MomentoEntraSolo`).
    momento: 'entra-solo',
  },
  {
    n: '2',
    titulo: 'Se ordena solo',
    afirma: ['ordena-categorias', 'ordena-fijos', 'ordena-topes'],
    // El Inicio del Mac: el veredicto del mes, las donas de tus topes y el ritmo (`MomentoComoVas`).
    momento: 'como-vas',
  },
  {
    n: '3',
    titulo: 'Te dice cómo vas',
    afirma: ['vas-tope', 'vas-viene', 'vas-mes-pasado'],
    // «Lo que viene» solo está probado en el iPhone: va en un iPhone (`MomentoQueViene`).
    momento: 'que-viene',
  },
];

// 6 · Lo que te llevas por entrar ahora. Sin cifras ni nada de plata (CA8, CA15); no afirma nada de la app.
const loQueTeLlevas = [
  { titulo: 'Entras primero', texto: 'Te escribimos apenas abra, antes que al resto.' },
  { titulo: 'Decides qué sigue', texto: 'Nos dices qué función construimos después.' },
];

// 7 · Preguntas frecuentes. Las que afirman algo de la app salen del inventario; la de la
// lista no afirma nada de la app. El JSON-LD de preguntas se arma de ESTA lista, así que no
// puede decir otra cosa que la página.
const faqs: { q: string; afirma?: string; a?: string; open?: boolean }[] = [
  { q: '¿Tengo que anotar cada gasto?', afirma: 'faq-anotar', open: true },
  { q: '¿Es seguro? ¿Dónde quedan mis datos?', afirma: 'faq-seguro' },
  { q: '¿Necesito dar la clave de mi banco?', afirma: 'faq-clave' },
  { q: '¿Qué bancos sirven?', afirma: 'faq-bancos' },
  { q: '¿En qué aparatos funciona?', afirma: 'faq-aparatos' },
  { q: '¿Unirme a la lista cuesta algo?', a: 'No. Solo te pedimos tu correo para avisarte cuando abramos.' },
];
const respuesta = (f: (typeof faqs)[number]): string => (f.afirma ? t(f.afirma) : (f.a ?? ''));
const jsonLd = {
  ...homeJsonLd,
  '@graph': [
    ...homeJsonLd['@graph'],
    {
      '@type': 'FAQPage',
      '@id': 'https://presu.io/#faq',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: respuesta(f) },
      })),
    },
  ],
};
---

<Base
  title="Presu — App de finanzas personales para Colombia | Sabes cómo vas este mes"
  description="¿Llega fin de mes y no sabes en qué se te fue la plata? Presu lee los movimientos de tu correo y tus extractos, los ordena solo y te dice cómo vas este mes. Llega a Mac, Windows e iPhone al mismo tiempo. Únete a la lista de espera."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <!-- ══════════════════ 1 · HERO: el dolor, la promesa, el video y la lista ══════════════════ -->
  <section class="hero">
    <div class="hero-glow hero-glow--emerald" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--indigo" aria-hidden="true"></div>

    <div class="hero-grid">
      <div class="hero-copy">
        <span class="pill-badge"><span class="ping"></span> Lista de espera abierta</span>
        <h1>¿Llega fin de mes y no sabes en qué se te <span class="mark">fue la plata</span>?</h1>
        <p class="pitch" data-afirma="promesa">{t('promesa')}</p>
        <p class="sub" data-afirma="llega-aparatos">{t('llega-aparatos')}</p>

        <form id="hero-form" class="capture" novalidate>
          <div class="capture-row">
            <input type="email" id="hero-email" name="email" autocomplete="email" placeholder="tu@correo.com" aria-label="Tu correo" required />
            <button type="submit" class="capture-btn">Únete a la lista
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
          </div>
          <p class="capture-err" id="hero-err">Revisa el correo —parece que le falta algo.</p>
          <p class="capture-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Te escribimos cuando abra · Sin spam
          </p>
        </form>

        <div class="capture-ok hidden" id="hero-ok" role="status">
          <span class="ok-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M20 6 9 17l-5-5"></path></svg></span>
          <span><strong>¡Listo, ya estás en la lista!</strong><span>Te escribimos primero cuando abramos —sin afán, sin spam.</span></span>
        </div>

        <div class="proof hidden" id="proof-hero">
          <span class="proof-dot" aria-hidden="true"></span><span class="avatars" aria-hidden="true"><i class="av"></i><i class="av"></i><i class="av"></i><i class="av"></i></span>
          <b class="count">—</b><span class="proof-txt">&nbsp;personas ya en la lista</span>
        </div>
        {TURNSTILE_SITE_KEY && <div id="ts-hero" class="cf-turnstile ts-widget" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible" data-appearance="interaction-only"></div>}
      </div>

      <!-- Derecha: el video (Tarea 9 lo reemplaza por `Vsl`). -->
      <div class="hero-viz">
        <div class="hero-shot-glow" aria-hidden="true"></div>
        <div class="hueco-vsl" role="img" aria-label="Aquí va el video: Presu de verdad, en el Mac y en el iPhone">
          <span class="hueco-vsl__play" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
          </span>
          <span class="hueco-rotulo">Video · 60 a 90 segundos</span>
          <span class="hueco-nota">Presu de verdad, en el Mac y en el iPhone</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════ 2 · EL DOLOR ══════════════════ -->
  <Section eyebrow="Te suena">
    <div class="sec-head reveal">
      <h2>No es que gastes de más. Es que <span class="mark">nunca lo ves</span> todo junto.</h2>
      <p class="sec-lead">Y anotar cada cosa a mano no es vida.</p>
    </div>
    <div class="dolores">
      {dolores.map((d) => (
        <div class="card reveal">
          <h3>{d.titulo}</h3>
          <p>{d.texto}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ══════════════════ 3 · TRES VERBOS ══════════════════ -->
  <Section id="como" eyebrow="Cómo funciona">
    <div class="sec-head reveal">
      <h2>Tú no anotas. Presu <span class="mark">hace el trabajo</span>.</h2>
      <p class="sec-lead">Tres cosas, en el Mac y en el iPhone.</p>
    </div>
    <div class="verbos">
      {verbos.map((v) => (
        <article class="verbo reveal">
          <div class="verbo__texto">
            <span class="step-n">{v.n}</span>
            <h3>{v.titulo}</h3>
            <ul class="verbo__lista">
              {v.afirma.map((id) => <li data-afirma={id}>{t(id)}</li>)}
            </ul>
          </div>
          <div class="verbo__media">
            {v.momento === 'entra-solo' && <MomentoEntraSolo />}
            {v.momento === 'como-vas' && <MomentoComoVas />}
            {v.momento === 'que-viene' && <MomentoQueViene />}
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- ══════════════════ 4 · TUS DATOS SON TUYOS ══════════════════ -->
  <Section id="privacidad" eyebrow="Tus datos son tuyos">
    <div class="privacy reveal">
      <div class="privacy-glow" aria-hidden="true"></div>
      <h2 data-afirma="privacidad-titulo">Solo tú tienes la llave.</h2>
      <p class="privacy-lead" data-afirma="privacidad-texto">{t('privacidad-texto')}</p>
      <div class="privacy-pills">
        <span class="ppill">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span data-afirma="pill-sin-clave">{t('pill-sin-clave')}</span>
        </span>
        <span class="ppill">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span data-afirma="pill-e2e">{t('pill-e2e')}</span>
        </span>
        <span class="ppill">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18.36 6.64A9 9 0 1 1 5.64 6.64"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
          <span data-afirma="pill-cuenta">{t('pill-cuenta')}</span>
        </span>
      </div>
    </div>
  </Section>

  <!-- ══════════════════ 5 · FAMILIA (sin precio) ══════════════════ -->
  <Section id="familia" eyebrow="Familia">
    <div class="familia reveal">
      <div class="familia__texto">
        <h2>Si la plata es <span class="mark">de la casa</span>, también.</h2>
        <p class="sec-lead" data-afirma="familia-texto">{t('familia-texto')}</p>
      </div>
    </div>
  </Section>

  <!-- ══════════════════ 6 · LO QUE TE LLEVAS (sin cifras) ══════════════════ -->
  <Section eyebrow="Por entrar ahora">
    <div class="offer reveal">
      <p class="offer-lead"><strong>Por entrar a la lista</strong>, te llevas esto:</p>
      <ul class="offer-stack">
        {loQueTeLlevas.map((b) => (
          <li>
            <span class="os-ic" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
            <span><strong>{b.titulo}</strong> — {b.texto}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- ══════════════════ 7 · PREGUNTAS ══════════════════ -->
  <Section id="preguntas" eyebrow="Preguntas frecuentes">
    <div class="sec-head reveal">
      <h2>Lo que la gente nos pregunta.</h2>
    </div>
    <div class="faq reveal">
      {faqs.map((f) => (
        <FaqItem question={f.q} answer={respuesta(f)} open={f.open} afirma={f.afirma} />
      ))}
    </div>
  </Section>

  <!-- ══════════════════ 8 · LA LISTA OTRA VEZ ══════════════════ -->
  <Section id="waitlist" eyebrow="Lista de espera">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="sec-head reveal">
      <h2>Que el próximo fin de mes <span class="mark">no te tome</span> por sorpresa.</h2>
      <p class="sec-lead" id="waitlist-lede">Déjanos tu correo y te avisamos apenas abramos. Sin spam.</p>
      <div class="proof hidden" id="proof-wait">
        <span class="proof-dot" aria-hidden="true"></span><span class="avatars" aria-hidden="true"><i class="av"></i><i class="av"></i><i class="av"></i><i class="av"></i></span>
        <b class="count">—</b><span class="proof-txt">&nbsp;personas ya en la lista</span>
      </div>
    </div>

    <div class="formcard reveal">
      <form id="waitlist-form" novalidate>
        <fieldset class="segmented" id="perfil-group">
          <legend>Soy</legend>
          <label class="seg"><input type="radio" name="perfil" value="persona" checked /> <span>Persona</span></label>
          <label class="seg"><input type="radio" name="perfil" value="empresa" /> <span>Empresa</span></label>
        </fieldset>

        <div class="field">
          <label for="email">Correo <span aria-hidden="true" class="req">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="tu@correo.com" required aria-required="true" />
          <p class="err" id="email-err">Revisa el correo —parece que le falta algo.</p>
        </div>

        <div class="field">
          <label for="nombre">Nombre <span class="opt">(opcional)</span></label>
          <input type="text" id="nombre" name="nombre" autocomplete="name" placeholder="Tu nombre" />
        </div>

        <div id="empresa-fields" class="hidden">
          <div class="field"><label for="empresa">Nombre de la empresa</label><input type="text" id="empresa" name="empresa" autocomplete="organization" placeholder="Tu empresa" /></div>
          <div class="field"><label for="empleados">N.º aproximado de empleados</label><input type="number" id="empleados" name="empleados" min="1" inputmode="numeric" placeholder="Ej. 50" /></div>
        </div>

        <div class="field consent">
          <input type="checkbox" id="consent" name="consent" required aria-required="true" />
          <label for="consent">Autorizo el tratamiento de mis datos según la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.</label>
        </div>
        <p class="err" id="consent-err">Solo falta tu visto bueno aquí para sumarte.</p>

        <input type="text" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {TURNSTILE_SITE_KEY && <div id="ts-wl" class="cf-turnstile ts-widget" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible" data-appearance="interaction-only"></div>}
        <button type="submit" class="capture-btn capture-btn--block">Únete a la lista de espera</button>
        <p class="err err--center" id="wl-err">Algo falló de nuestro lado. Reintenta en un momento.</p>
        <p class="form-foot"><span data-afirma="form-aparatos">{t('form-aparatos')}</span> · Presu, de Asimétrica</p>
      </form>

      <div id="waitlist-success" class="success hidden" role="status">
        <span class="success-ic" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"></path></svg></span>
        <h3>¡Listo, ya estás en la lista!</h3>
        <p>Te escribimos primero cuando abramos. Tu plata, clara —muy pronto.</p>
      </div>
    </div>
  </Section>

  <!-- ══════════════ ENCUESTA POST-REGISTRO (modal, oculto por defecto) ══════════════ -->
  <div id="connect-modal" class="connect-modal" role="dialog" aria-modal="true" aria-label="Cuéntanos un poco más">
    <div class="connect-modal__card">
      <button type="button" class="connect-modal__close" aria-label="Ahora no">Ahora no</button>
      <iframe title="Conectemos con Presu" allow="clipboard-write"></iframe>
    </div>
  </div>
  {TURNSTILE_SITE_KEY && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
</Base>

<!-- Estilos globales: los tocan/inyectan countdown.js y waitlist.js
     (el .mark inicial se vuelve .mintword tras el flip; el badge inyecta .ping). -->
<style is:global>
  .mark,
  .mintword {
    position: relative;
    color: var(--presu-emerald);
    white-space: nowrap;
  }
  .mark::after,
  .mintword::after {
    content: '';
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    bottom: 0.05em;
    height: 0.12em;
    border-radius: 999px;
    background: var(--presu-emerald);
    opacity: 0.85;
    transform: rotate(-1.4deg);
    transform-origin: left center;
  }
  .ping {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--presu-emerald);
    box-shadow: 0 0 10px var(--presu-emerald);
    animation: presu-blink 2s infinite;
  }
</style>

<style>
  /* ───────────────── HERO ───────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-16) var(--screen-pad) var(--space-12);
  }
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-glow--emerald {
    width: 560px;
    height: 560px;
    right: -180px;
    top: -180px;
    background: radial-gradient(circle, rgba(52, 211, 153, 0.22), transparent 65%);
  }
  .hero-glow--indigo {
    width: 480px;
    height: 480px;
    left: -200px;
    bottom: -200px;
    background: radial-gradient(circle, rgba(129, 140, 248, 0.16), transparent 65%);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: var(--space-10);
    align-items: center;
  }
  .hero-grid > * {
    min-width: 0;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--fill-emerald);
    border: 1px solid var(--fill-emerald-border);
    color: var(--presu-emerald);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--text-label);
    padding: 7px 15px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-5);
  }

  .hero-copy h1 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(2.1rem, 5.2vw, var(--text-display));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    text-wrap: balance;
  }
  .hero-copy .pitch {
    margin: 0 0 var(--space-3);
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
    max-width: 34em;
  }
  .hero-copy .sub {
    margin: 0 0 var(--space-6);
    font-size: var(--text-body);
    line-height: var(--leading-normal);
    color: var(--text-tertiary);
    max-width: 34em;
  }

  /* Captura */
  .capture {
    max-width: 470px;
  }
  .capture-row {
    display: flex;
    gap: var(--space-2);
  }
  .capture input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--text-primary);
  }
  .capture input::placeholder {
    color: var(--text-tertiary);
  }
  .capture input:focus-visible {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: var(--focus-ring);
  }
  .capture input.err {
    border-color: var(--color-negative);
  }
  .capture-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    flex-shrink: 0;
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: var(--presu-emerald);
    color: var(--text-on-accent);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-label);
    white-space: nowrap;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .capture-btn:hover {
    background: var(--presu-emerald-press);
    box-shadow: var(--shadow-accent);
  }
  .capture-btn:active {
    transform: scale(0.97);
  }
  .capture-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .capture-btn.loading {
    opacity: 0.65;
    pointer-events: none;
  }
  .capture-btn--block {
    width: 100%;
    margin-top: var(--space-2);
  }
  .capture-err {
    display: none;
    margin: var(--space-2) 0 0;
    font-size: var(--text-caption);
    color: var(--color-negative);
  }
  .capture-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--text-caption);
    color: var(--text-tertiary);
  }
  .capture-note svg {
    color: var(--presu-emerald);
    flex-shrink: 0;
  }

  .capture-ok {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 470px;
    padding: var(--space-4);
    background: var(--fill-emerald);
    border: 1px solid var(--fill-emerald-border);
    border-radius: var(--radius-lg);
  }
  .capture-ok .ok-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--presu-emerald);
    color: var(--text-on-accent);
  }
  .capture-ok strong {
    display: block;
    color: var(--text-primary);
    font-weight: var(--weight-bold);
  }
  .capture-ok span span {
    display: block;
    margin-top: 2px;
    font-size: var(--text-caption);
    color: var(--text-secondary);
  }

  .proof {
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    max-width: 100%;
    margin-top: var(--space-5);
    padding: 8px 15px 8px 12px;
    background: rgba(52, 211, 153, 0.06);
    border: 1px solid rgba(52, 211, 153, 0.2);
    border-radius: 999px;
    font-size: var(--text-caption);
    color: var(--text-secondary);
  }
  .proof .proof-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--presu-emerald);
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
    animation: proof-pulse 2s infinite;
  }
  @keyframes proof-pulse {
    0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0); }
    100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .proof .proof-dot { animation: none; } }
  .proof .avatars {
    display: inline-flex;
    align-items: center;
  }
  .proof .avatars .av {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--bg-base, #08080a);
    margin-left: -8px;
  }
  .proof .avatars .av:first-child {
    margin-left: 0;
  }
  .proof .avatars .av:nth-child(1) { background: linear-gradient(135deg, #34d399, #059669); }
  .proof .avatars .av:nth-child(2) { background: linear-gradient(135deg, #60a5fa, #2563eb); }
  .proof .avatars .av:nth-child(3) { background: linear-gradient(135deg, #fbbf24, #d97706); }
  .proof .avatars .av:nth-child(4) { background: linear-gradient(135deg, #f472b6, #db2777); }
  .proof .count {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    color: var(--presu-emerald);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    display: inline-block;
  }
  .proof .count.bumped {
    animation: count-bump 0.5s var(--ease-out, cubic-bezier(0.2, 0.7, 0.2, 1));
  }
  @keyframes count-bump {
    0% { transform: scale(1); }
    35% { transform: scale(1.28); color: var(--presu-emerald); }
    100% { transform: scale(1); }
  }

  /* Sacudida en campo con error (email inválido / falta consentimiento) */
  .shake {
    animation: field-shake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }
  @keyframes field-shake {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-5px); }
    40%, 60% { transform: translateX(5px); }
  }

  /* Hero viz (derecha) */
  .hero-viz {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hero-shot-glow {
    position: absolute;
    z-index: 0;
    inset: -12% -10%;
    background: radial-gradient(
      55% 55% at 52% 42%,
      rgba(52, 211, 153, 0.5),
      rgba(129, 140, 248, 0.28) 45%,
      transparent 72%
    );
    filter: blur(72px);
    opacity: 0.55;
    pointer-events: none;
  }
  /* ───────── Huecos: pantallazos (Tarea 8) y video (Tarea 9) ─────────
     Un panel oscuro enmarcado con su rótulo, para que la página se vea terminada
     mientras llegan las piezas reales. Lo reemplazan `Captura` y `Vsl`. */
  .hueco-vsl {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    text-align: center;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(52, 211, 153, 0.08), transparent 60%),
      var(--surface-alt);
    border: 1px solid var(--border);
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9);
  }
  .hueco-vsl {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
  }
  .hueco-vsl__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--presu-emerald);
    color: var(--text-on-accent);
    box-shadow: var(--shadow-accent);
  }
  .hueco-rotulo {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .hueco-nota {
    font-size: var(--text-caption);
    color: var(--text-tertiary);
  }

  /* ───────────────── Cabeceras de sección ───────────────── */
  .sec-head {
    max-width: 44rem;
  }
  .sec-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    text-wrap: balance;
  }
  .sec-lead {
    margin: var(--space-3) 0 0;
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  /* ───────────────── 2 · El dolor ───────────────── */
  .dolores {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  /* ───────────────── 3 · Tres verbos ───────────────── */
  .verbos {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .verbo {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-10);
    align-items: center;
  }
  .verbo > * {
    min-width: 0;
  }
  .verbo:nth-child(even) {
    grid-template-columns: 1.2fr 0.8fr;
  }
  .verbo:nth-child(even) .verbo__texto {
    order: 2;
  }
  .verbo h3 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }
  .verbo__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .verbo__lista li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }
  .verbo__lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 10px;
    height: 2px;
    border-radius: 2px;
    background: var(--presu-emerald);
  }

  /* ───────────────── 5 · Familia ───────────────── */
  .familia {
    max-width: 44rem;
  }
  .familia h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    text-wrap: balance;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .card-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }
  .card-ic--negative {
    background: var(--fill-rose);
    color: var(--color-negative);
  }
  .card-ic--info {
    background: var(--fill-indigo);
    color: var(--color-info);
  }
  .card-ic--positive {
    background: var(--fill-emerald);
    color: var(--presu-emerald);
  }
  .card h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-h3);
    color: var(--text-primary);
  }
  .card p {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background: var(--fill-emerald);
    border: 1px solid var(--fill-emerald-border);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h3);
    color: var(--presu-emerald);
  }

  /* ───────────────── 6 · Privacidad (firma) ───────────────── */
  .privacy {
    position: relative;
    overflow: hidden;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-8);
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }
  .privacy-glow {
    position: absolute;
    width: 380px;
    height: 380px;
    right: -120px;
    top: -140px;
    border-radius: 50%;
    background: var(--glow-emerald);
    filter: blur(30px);
    pointer-events: none;
  }
  .privacy h2 {
    position: relative;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h1);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }
  .privacy-lead {
    position: relative;
    margin: 0 auto var(--space-6);
    max-width: 52ch;
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }
  .privacy-lead strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }
  .privacy-pills {
    position: relative;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .ppill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-label);
    color: var(--text-primary);
  }
  .ppill svg {
    color: var(--presu-emerald);
  }

  .offer {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
    padding: var(--space-6);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .os-eb {
    display: inline-block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--presu-emerald);
  }
  .offer-lead {
    margin: 0 0 var(--space-2);
    font-size: var(--text-body-lg);
    color: var(--text-primary);
  }
  .offer-lead strong {
    color: var(--presu-emerald);
  }
  .offer-note {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--text-tertiary);
  }
  .offer-stack {
    list-style: none;
    margin: var(--space-5) auto;
    padding: 0;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-align: left;
  }
  .offer-stack li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
  }
  .offer-stack strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }
  .os-ic {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    background: rgba(52, 211, 153, 0.15);
    color: var(--presu-emerald);
  }
  .os-tag {
    flex-shrink: 0;
    margin-top: 1px;
    padding: 2px 9px;
    border-radius: var(--radius-full);
    background: var(--presu-emerald);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    line-height: 1.5;
  }

  /* ───────────────── 9 · CTA / Waitlist ───────────────── */
  .cta-glow {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 520px;
    height: 420px;
    max-width: 90vw;
    background: var(--glow-emerald);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }
  #waitlist .sec-head {
    position: relative;
    z-index: 1;
    text-align: center;
    margin: 0 auto;
  }
  #waitlist .proof {
    justify-content: center;
  }

  .formcard {
    position: relative;
    z-index: 1;
    max-width: 520px;
    margin: 0 auto;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  .segmented {
    display: flex;
    gap: var(--space-2);
    border: 0;
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  .segmented legend {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
    padding: 0;
  }
  .seg {
    flex: 1;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg span {
    display: block;
    text-align: center;
    padding: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--text-label);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .seg input:checked + span {
    background: var(--fill-emerald);
    border-color: var(--fill-emerald-border);
    color: var(--presu-emerald);
  }
  .seg input:focus-visible + span {
    box-shadow: var(--focus-ring);
  }

  .field {
    margin-bottom: var(--space-4);
  }
  .field label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--text-secondary);
  }
  .field .req {
    color: var(--presu-emerald);
  }
  .field .opt {
    font-weight: var(--weight-regular);
    color: var(--text-tertiary);
  }
  .field input[type='email'],
  .field input[type='text'],
  .field input[type='number'] {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--text-primary);
  }
  .field input::placeholder {
    color: var(--text-tertiary);
  }
  .field input:focus-visible {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: var(--focus-ring);
  }
  .field input.err {
    border-color: var(--color-negative);
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .consent input {
    margin-top: 2px;
    accent-color: var(--presu-emerald);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .consent label {
    margin: 0;
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--text-tertiary);
  }
  .consent label a {
    color: var(--presu-emerald);
    text-decoration: none;
  }
  .err {
    display: none;
    margin: 0 0 var(--space-3);
    font-size: var(--text-caption);
    color: var(--color-negative);
  }
  .err--center {
    text-align: center;
    margin-top: var(--space-3);
  }
  .form-foot {
    margin: var(--space-4) 0 0;
    text-align: center;
    font-size: var(--text-caption);
    color: var(--text-tertiary);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .success {
    text-align: center;
    padding: var(--space-8) var(--space-4);
  }
  .success-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background: var(--presu-emerald);
    color: var(--text-on-accent);
  }
  .success h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h2);
    color: var(--text-primary);
  }
  .success p {
    margin: 0;
    color: var(--text-secondary);
  }

  /* ───────────────── Encuesta post-registro (modal) ───────────────── */
  .connect-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
    background: rgba(4, 4, 6, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .connect-modal.is-open {
    display: flex;
  }
  .connect-modal__card {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .connect-modal__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    background: var(--surface-elevated);
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    cursor: pointer;
  }
  .connect-modal__close:hover {
    color: var(--text-primary);
  }
  .connect-modal iframe {
    width: 100%;
    flex: 1;
    min-height: 540px;
    border: 0;
    background: transparent;
    display: block;
  }
  @media (max-width: 560px) {
    .connect-modal {
      padding: 0;
    }
    .connect-modal__card {
      max-width: none;
      height: 100dvh;
      max-height: none;
      border-radius: 0;
    }
  }

  /* ───────────────── Utilidades ───────────────── */
  .hidden {
    display: none !important;
  }

  /* Reveal on scroll — visible por defecto (sin JS); solo se oculta cuando
     el JS marca <body class="reveal-ready"> y respeta reduced-motion. */
  .reveal-ready .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .reveal-ready .reveal.in {
    opacity: 1;
    transform: none;
  }
  .pop-in {
    animation: presu-rise 0.4s var(--ease-out) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-ready .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ───────────────── Responsive ───────────────── */
  @media (max-width: 960px) {
    .hero-grid,
    .verbo,
    .familia {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .hero-viz {
      order: 2;
    }
    .verbo:nth-child(even) {
      grid-template-columns: 1fr;
    }
    .verbo:nth-child(even) .verbo__texto {
      order: 0;
    }
    .dolores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-10);
    }
    .capture-row {
      flex-direction: column;
    }
    .capture-btn {
      width: 100%;
    }
    .dolores {
      grid-template-columns: 1fr;
    }
    .verbos {
      gap: var(--space-16);
    }
    .hueco-rotulo {
      font-size: 0.62rem;
    }
    .hueco-nota {
      display: none;
    }
    .sec-head h2,
    .privacy h2,
    .familia h2 {
      font-size: var(--text-h2);
    }
    .privacy {
      padding: var(--space-10) var(--space-5);
    }
  }
</style>

<script>
  import { apiBase } from '../scripts/api.js';
  import { send, isNuevaOla } from '../scripts/waitlist.js';

  const REDUCE = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const API = apiBase(location.hostname);

  // Token de Turnstile del widget con id `wid` (el widget puede estar FUERA del
  // form). Lee el hidden input que Turnstile inyecta; cae a getResponse() si hace falta.
  const tsToken = (wid: string): string => {
    const el = document.getElementById(wid);
    if (!el) return '';
    const inp =
      el.querySelector('[name="cf-turnstile-response"]') ||
      (el.parentElement && el.parentElement.querySelector('[name="cf-turnstile-response"]'));
    if (inp) return (inp as HTMLInputElement).value || '';
    try { if ((window as any).turnstile) return (window as any).turnstile.getResponse(el) || ''; } catch {}
    return '';
  };
  // Espera a que el widget resuelva (hasta ~8s) antes de enviar, para que un submit
  // rápido no falle con el token aún vacío. Sin widget → resuelve de una.
  const tsTokenReady = (wid: string): Promise<string> =>
    new Promise((resolve) => {
      if (!(window as any).turnstile || !document.getElementById(wid)) return resolve(tsToken(wid));
      const t = tsToken(wid);
      if (t) return resolve(t);
      let n = 0;
      const iv = setInterval(() => {
        const v = tsToken(wid);
        if (v || ++n > 40) { clearInterval(iv); resolve(v); }
      }, 200);
    });
  const tsReset = (wid: string) => {
    try { const el = document.getElementById(wid); (window as any).turnstile && el && (window as any).turnstile.reset(el); } catch {}
  };

  // Código de referido entrante (?ref=) — se recuerda por si vuelve luego.
  const REF = (() => {
    try {
      const u = new URLSearchParams(location.search).get('ref');
      if (u) localStorage.setItem('presu_ref', u.toUpperCase());
      return (localStorage.getItem('presu_ref') || '').toUpperCase();
    } catch {
      return '';
    }
  })();

  const track = (perfil: string, origen: string) => {
    if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'generate_lead', { perfil, origen });
  };

  // ── Count-up: la cifra cuenta hasta su valor (respeta reduced-motion). ──
  function countUp(el: HTMLElement) {
    if (el.dataset.counted) return;
    el.dataset.counted = '1';
    const raw = (el.textContent || '').trim();
    const m = raw.match(/^([^\d-]*)(-?[\d.,]+)(.*)$/);
    if (!m) return;
    const pre = m[1];
    const numStr = m[2];
    const suf = m[3];
    const hasComma = numStr.indexOf(',') >= 0;
    const val = parseFloat(numStr.replace(/\./g, '').replace(',', '.'));
    if (isNaN(val)) return;
    const dec = hasComma ? (numStr.split(',')[1] || '').length : 0;
    const fmt = (n: number) =>
      pre + n.toLocaleString('es-CO', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf;
    const dur = 1100;
    let t0: number | null = null;
    const step = (ts: number) => {
      if (t0 === null) t0 = ts;
      const p = Math.min(1, (ts - t0) / dur);
      el.textContent = fmt(val * (1 - Math.pow(1 - p, 3)));
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = raw;
    };
    requestAnimationFrame(step);
  }

  // ── Confeti de celebración al inscribirse (respeta reduced-motion). ──
  function celebrate() {
    if (REDUCE) return;
    const cv = document.createElement('canvas');
    cv.style.cssText =
      'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:120';
    document.body.appendChild(cv);
    const ctx = cv.getContext('2d');
    if (!ctx) {
      cv.remove();
      return;
    }
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = window.innerWidth;
    const h = window.innerHeight;
    cv.width = w * dpr;
    cv.height = h * dpr;
    ctx.scale(dpr, dpr);
    const COLORS = ['#34D399', '#5EEAB8', '#F4F4F3', '#FBBF24', '#818CF8'];
    const parts = Array.from({ length: 96 }, () => ({
      x: w / 2 + (Math.random() - 0.5) * w * 0.5,
      y: h * 0.34 + (Math.random() - 0.5) * 80,
      vx: (Math.random() - 0.5) * 9,
      vy: Math.random() * -9 - 4,
      g: 0.28 + Math.random() * 0.12,
      s: 5 + Math.random() * 6,
      rot: Math.random() * Math.PI,
      vr: (Math.random() - 0.5) * 0.32,
      c: COLORS[Math.floor(Math.random() * COLORS.length)],
    }));
    const DUR = 1700;
    let t0: number | null = null;
    const frame = (ts: number) => {
      if (t0 === null) t0 = ts;
      const el = ts - t0;
      ctx.clearRect(0, 0, w, h);
      parts.forEach((p) => {
        p.vy += p.g;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = Math.max(0, 1 - el / DUR);
        ctx.fillStyle = p.c;
        ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.62);
        ctx.restore();
      });
      if (el < DUR) requestAnimationFrame(frame);
      else cv.remove();
    };
    requestAnimationFrame(frame);
  }

  // ── CTA tras inscribirse: convierte al nuevo inscrito en referidor. ──
  function referralCTA(code: string) {
    if (!code) return '';
    return (
      '<div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">' +
      '<div style="font-weight:600;color:var(--text-primary);margin-bottom:6px">Ahora vuélvete Fundador 🚀</div>' +
      '<div style="font-size:.9rem;color:var(--text-secondary);margin-bottom:12px">Invita amigos y desbloquea bonos extra. El Top 3 se lleva acompañamiento 1:1 + libro, gratis.</div>' +
      '<a href="/fundador.html?code=' +
      code +
      '" style="display:inline-flex;align-items:center;gap:7px;background:var(--presu-emerald);color:var(--text-on-accent);font-weight:700;text-decoration:none;padding:11px 18px;border-radius:12px;font-size:.92rem">Ver mi panel e invitar →</a>' +
      '</div>'
    );
  }

  // ── Contador de registros en vivo (Worker/KV). ──
  let lastCount = 0;
  const fmtCount = (n: number) => {
    try {
      return n.toLocaleString('es-CO');
    } catch {
      return String(n);
    }
  };
  function renderCount(total: number) {
    if (total <= 0) return;
    const first = lastCount === 0;
    lastCount = total;
    document.querySelectorAll<HTMLElement>('.count').forEach((el) => {
      el.textContent = fmtCount(total);
      if (first && !REDUCE) countUp(el);
      else if (!first && !REDUCE) {
        el.classList.remove('bumped');
        void el.offsetWidth; // reflow para reiniciar el pulso
        el.classList.add('bumped');
      }
    });
    document.querySelectorAll('.proof').forEach((el) => el.classList.remove('hidden'));
  }
  function loadCount() {
    fetch(API + '/count', { cache: 'no-store' })
      .then((r) => r.json())
      .then((d) => {
        if (d && typeof d.count === 'number') renderCount(d.count);
      })
      .catch(() => {});
  }
  function bumpCount() {
    if (lastCount > 0) renderCount(lastCount + 1);
    setTimeout(loadCount, 1800);
  }
  loadCount();
  setInterval(loadCount, 15000);

  // ── Ventana post-registro: encuesta opcional (Nombre → WhatsApp → perfil) en un iframe ──
  // Reutiliza encuesta.html en modo nuevo+embed; guarda incremental (cada campo apenas se llena).
  let connectShown = false;
  function openConnect(email: string, st?: string) {
    if (connectShown || !email) return;
    connectShown = true;
    const ov = document.getElementById('connect-modal');
    if (!ov) return;
    const iframe = ov.querySelector<HTMLIFrameElement>('iframe');
    if (iframe) iframe.src = '/encuesta.html?e=' + encodeURIComponent(email) + '&t=' + encodeURIComponent(st || '') + '&nuevo=1&embed=1';
    ov.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'connect_open');
  }
  function closeConnect() {
    const ov = document.getElementById('connect-modal');
    if (ov) ov.classList.remove('is-open');
    document.body.style.overflow = '';
  }
  (() => {
    const ov = document.getElementById('connect-modal');
    if (!ov) return;
    ov.addEventListener('click', (e) => {
      if (e.target === ov) closeConnect();
    });
    ov.querySelector('.connect-modal__close')?.addEventListener('click', closeConnect);
  })();
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeConnect();
  });
  window.addEventListener('message', (e: MessageEvent) => {
    const d = e && (e.data as any);
    if (d && (d.presu === 'survey-close' || d.presu === 'survey-complete')) {
      closeConnect();
    }
  });

  // ── Micro-feedback en formularios ──
  function shakeErr(el: HTMLInputElement) {
    el.classList.add('err');
    if (!REDUCE) {
      el.classList.remove('shake');
      void el.offsetWidth; // reflow para reiniciar la animación
      el.classList.add('shake');
      setTimeout(() => el.classList.remove('shake'), 450);
    }
    const clear = () => {
      el.classList.remove('err');
      el.removeEventListener('input', clear);
    };
    el.addEventListener('input', clear);
  }
  function btnLoading(f: HTMLFormElement, on: boolean) {
    const b = f.querySelector<HTMLButtonElement>('button[type=submit]');
    if (b) {
      b.classList.toggle('loading', on);
      b.disabled = on;
    }
  }

  // ── Hero capture ──
  const heroForm = document.getElementById('hero-form') as HTMLFormElement | null;
  if (heroForm) {
    const heroEmail = document.getElementById('hero-email') as HTMLInputElement;
    const heroErr = document.getElementById('hero-err') as HTMLElement;
    const heroOk = document.getElementById('hero-ok') as HTMLElement;
    heroForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = heroEmail.value.trim();
      if (!EMAIL_RE.test(email)) {
        heroErr.textContent = 'Revisa el correo —parece que le falta algo.';
        heroErr.style.display = 'block';
        shakeErr(heroEmail);
        heroEmail.focus();
        return;
      }
      heroErr.style.display = 'none';
      btnLoading(heroForm, true);
      const late = isNuevaOla();
      tsTokenReady('ts-hero').then((tok) => send(
        { perfil: 'persona', correo: email, origen: late ? 'tanda2' : 'hero', ref: REF, turnstile: tok },
        (res) => {
          heroForm.style.display = 'none';
          if (late) {
            heroOk.querySelector('strong')!.textContent = '¡Listo, estás en la Nueva Ola! 🌊';
            heroOk.querySelector('span span')!.textContent =
              'Te avisamos apenas abramos cupos. Comparte tu link para subir en la fila.';
          }
          heroOk.classList.remove('hidden');
          heroOk.classList.add('pop-in');
          if (res && (res as any).ref) heroOk.insertAdjacentHTML('afterend', referralCTA((res as any).ref));
          bumpCount();
          celebrate();
          track('persona', late ? 'tanda2' : 'hero');
          openConnect(email, (res as any)?.st);
        },
        () => {
          btnLoading(heroForm, false);
          tsReset('ts-hero');
          heroErr.textContent = 'Algo falló de nuestro lado. Reintenta en un momento.';
          heroErr.style.display = 'block';
        },
        () => {
          heroForm.style.display = 'none';
          heroOk.querySelector('strong')!.textContent = '¡Ya estás inscrito! 🎉';
          heroOk.querySelector('span span')!.textContent = late
            ? 'Si eres pionero, ya tienes acceso (revisa tu correo 📩).'
            : 'Ese correo ya está inscrito. Te avisamos primero cuando abramos.';
          heroOk.classList.remove('hidden');
          heroOk.classList.add('pop-in');
          openConnect(email);
        }
      ));
    });
  }

  // ── Formulario completo (Nueva Ola) ──
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  if (form) {
    const empresaFields = document.getElementById('empresa-fields') as HTMLElement;
    const empresaInput = document.getElementById('empresa') as HTMLInputElement;
    const syncPerfil = () => {
      const esEmpresa =
        (form.querySelector('input[name=perfil]:checked') as HTMLInputElement).value === 'empresa';
      empresaFields.classList.toggle('hidden', !esEmpresa);
      if (empresaInput) empresaInput.required = esEmpresa;
    };
    form.querySelectorAll('input[name=perfil]').forEach((r) => r.addEventListener('change', syncPerfil));
    document.querySelectorAll('[data-perfil=empresa]').forEach((a) => {
      a.addEventListener('click', () => {
        (form.querySelector('input[name=perfil][value=empresa]') as HTMLInputElement).checked = true;
        syncPerfil();
      });
    });
    const showError = (id: string, show: boolean) => {
      const el = document.getElementById(id);
      if (el) el.style.display = show ? 'block' : 'none';
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if ((form as any).botcheck.value) return;
      const email = (form as any).email.value.trim();
      const emailOk = EMAIL_RE.test(email);
      const consentOk = (form as any).consent.checked;
      showError('email-err', !emailOk);
      showError('consent-err', !consentOk);
      if (!emailOk) {
        shakeErr((form as any).email);
        (form as any).email.focus();
        return;
      }
      if (!consentOk) {
        (form as any).consent.focus();
        return;
      }
      showError('wl-err', false);
      btnLoading(form, true);
      const perfil = (form.querySelector('input[name=perfil]:checked') as HTMLInputElement).value;
      tsTokenReady('ts-wl').then((tok) => send(
        {
          perfil,
          correo: email,
          nombre: (form as any).nombre.value.trim(),
          empresa: perfil === 'empresa' ? (form as any).empresa.value.trim() : '',
          empleados: perfil === 'empresa' ? (form as any).empleados.value.trim() : '',
          ref: REF,
          turnstile: tok,
        },
        (res) => {
          form.classList.add('hidden');
          const s = document.getElementById('waitlist-success')!;
          s.classList.remove('hidden');
          s.classList.add('pop-in');
          if (res && (res as any).ref) s.insertAdjacentHTML('beforeend', referralCTA((res as any).ref));
          bumpCount();
          celebrate();
          track(perfil, 'form');
          openConnect(email, (res as any)?.st);
        },
        () => {
          btnLoading(form, false);
          tsReset('ts-wl');
          showError('wl-err', true);
        },
        () => {
          const s = document.getElementById('waitlist-success')!;
          s.querySelector('h3')!.textContent = '¡Ya estás en la lista! 🎉';
          s.querySelector('p')!.textContent =
            'Ese correo ya está inscrito. Te avisamos primero cuando abramos cupos.';
          form.classList.add('hidden');
          s.classList.remove('hidden');
          s.classList.add('pop-in');
          openConnect(email);
        }
      ));
    });
  }

  // ── Reveal on scroll ──
  const reveals = Array.from(document.querySelectorAll('.reveal'));
  document.body.classList.add('reveal-ready');
  if ('IntersectionObserver' in window && !REDUCE) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -10% 0px' }
    );
    reveals.forEach((el) => io.observe(el));
    // Red de seguridad: nada queda oculto si el observer falla.
    setTimeout(() => reveals.forEach((el) => el.classList.add('in')), 1600);
  } else {
    reveals.forEach((el) => el.classList.add('in'));
  }

</script>
