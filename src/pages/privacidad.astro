---
/**
 * La política de privacidad que se publica es `src/legales/privacidad.md`, una COPIA TAL CUAL
 * de `PRIVACY.md` del repo de la app (esteban86/presu-desktop). Antes esta página era un
 * segundo texto escrito a mano, y se atrasaba: el 22-oct-2026 decía que Presu IA «viene activa
 * por defecto» cuando la app ya la traía apagada, y le faltaba la sección de datos de Google
 * que pide la verificación de Gmail.
 *
 * Para ponerla al día: copiar el `PRIVACY.md` de `main` de la app sobre
 * `src/legales/privacidad.md`. No se edita aquí. Lo vigila `src/test/privacidad-es-la-de-la-app.test.js`.
 */
import Base from '../layouts/Base.astro';
import { Content } from '../legales/privacidad.md';
---

<Base
  sinVenta
  title="Política de privacidad · Presu"
  description="Cómo Presu trata tus datos: tus finanzas viven en tus dispositivos y, si activas la sincronización, viajan cifradas de extremo a extremo; solo el dato mínimo viaja para funciones opcionales en la nube."
>
  <main class="legal">
    <div class="legal-wrap">
      <p class="eyebrow">Legal</p>
      <div class="contenido">
        <Content />
      </div>

      <div class="legal-foot">
        <a class="back" href="/">← Volver a presu.</a>
        <a href="/terminos">Términos y condiciones</a>
        <a href="mailto:soporte@presu.io">soporte@presu.io</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .legal {
    padding: var(--space-16) var(--screen-pad) var(--space-20);
  }

  .legal-wrap {
    max-width: 720px;
    margin: 0 auto;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--presu-emerald);
    margin: 0 0 var(--space-2);
  }

  .contenido :global(h1) {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h1);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-2);
    color: var(--text-primary);
  }

  .contenido :global(h1 + p) {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-tertiary);
    margin: 0 0 var(--space-8);
  }

  .contenido :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-10) 0 var(--space-3);
    color: var(--text-primary);
  }

  .contenido :global(p) {
    color: var(--text-secondary);
    font-size: var(--text-body);
    margin: 0 0 var(--space-4);
  }

  .contenido :global(ul) {
    color: var(--text-secondary);
    font-size: var(--text-body);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  .contenido :global(li) {
    margin-bottom: var(--space-2);
  }

  .contenido :global(strong),
  .contenido :global(b) {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  .contenido :global(a) {
    color: var(--presu-emerald);
    text-decoration: none;
  }

  .contenido :global(a:hover),
  .contenido :global(a:focus-visible) {
    text-decoration: underline;
  }

  .contenido :global(code) {
    font-family: var(--font-mono);
    font-size: 0.84em;
    background: var(--surface);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
  }

  .contenido :global(h1 + p em) {
    font-style: normal;
  }

  .contenido :global(ul ul) {
    margin: var(--space-2) 0 0;
  }

  .contenido :global(blockquote) {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--presu-emerald);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-4);
  }

  .contenido :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .legal-foot {
    margin-top: var(--space-12);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--text-tertiary);
    font-size: var(--text-caption);
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    align-items: center;
  }

  .legal-foot a {
    color: var(--text-secondary);
  }

  .back {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-label);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
  }

  .back:hover,
  .back:focus-visible {
    text-decoration: none;
    border-color: var(--border-strong);
  }
</style>
