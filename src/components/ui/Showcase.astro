---
// Showcase — "Mira lo que verás por dentro"
// Sección de vistas de la app: pantallazos REALES del Mac y del iPhone con la base de
// demostración (spec «presu.io que vende», §6.2; receta en el repo de la app,
// docs/web/capturas.md). Las cifras de los pies salen de la misma demo
// (src/lib/cifras-de-la-demo.js): ninguna se escribe a mano. Autocontenida: trae sus
// propios tokens y CSS con <style> scoped de Astro (aislado del resto del landing).
import Captura from './Captura.astro';
import { cifras, cifraDelMes, topeDe } from '../../lib/cifras-de-la-demo.js';
import { formatCOP } from '../../lib/format.js';

const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const [anio, mes] = cifras.mes.split('-').map(Number);
const mesDeLaDemo = `${MESES[mes - 1]} de ${anio}`;
const mercado = topeDe('Mercado');
---

<section class="presu-showcase">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow center-eb">Funciones</span><h2>Mira lo que verás por dentro</h2></div>

    <div class="show">

      <!-- A · Inicio -->
      <div class="show-row reveal">
        <div class="show-copy">
          <span class="eyebrow">¿Voy bien este mes?</span>
          <h3 data-afirma="inicio-titulo">Ingresos y gastos del mes, al instante</h3>
          <p data-afirma="inicio-texto">Abres Presu y ya sabes cómo vas: cuánto entró y cuánto salió, con la variación contra el mes pasado y tus presupuestos por categoría. La respuesta primero; los números, si los quieres.</p>
          <ul class="show-list">
            <li data-afirma="inicio-bancos"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Todos tus bancos sumados en una sola vista</li>
            <li data-afirma="inicio-vs-mes"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Comparación automática contra el mes anterior</li>
            <li data-afirma="inicio-anillos"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Presupuestos por categoría en anillos</li>
          </ul>
        </div>
        <div class="show-art show-art--capturas">
          <div class="panel-glow" style="background:linear-gradient(120deg,#818CF8,#34D399)"></div>
          <figure class="capturas">
            <div class="capturas__mac"><Captura src="/capturas/escritorio-inicio.webp" alt="Presu en el Mac con la demo: el Inicio dice cuánto te queda de tu tope, con ingresos, gastos, balance y los presupuestos del mes en anillos" aparato="mac" ancho={640} prioridad /></div>
            <div class="capturas__iphone"><Captura src="/capturas/celular-inicio.webp" alt="Presu en el iPhone con la demo: el Inicio dice cuánto llevas en tus topes y dibuja el gasto del mes contra el tope" aparato="iphone" ancho={190} /></div>
            <figcaption class="capturas__pie">Pantallas reales con la demo de {mesDeLaDemo}: entraron {cifraDelMes('ingresos')}, salieron {cifraDelMes('gastos')} y quedan {cifraDelMes('balance')}.</figcaption>
          </figure>
        </div>
      </div>

      <!-- B · Ritmo de gasto -->
      <div class="show-row rev reveal">
        <div class="show-copy">
          <span class="eyebrow">¿Vas a llegar a fin de mes?</span>
          <h3 data-afirma="ritmo-titulo">Tu ritmo de gasto, contra tu tope</h3>
          <p data-afirma="ritmo-texto">Presu dibuja lo que llevas gastado sobre lo que irías gastando para cerrar en tu tope, y el tope mismo. Si vas muy rápido, lo ves días antes —no cuando ya es tarde.</p>
          <ul class="show-list">
            <li data-afirma="ritmo-dia-a-dia"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Gasto real contra tu tope, día a día</li>
            <li data-afirma="ritmo-techo"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Tu tope a la vista en la gráfica</li>
            <li data-afirma="ritmo-proyeccion"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Proyección de cómo cerrarás el mes</li>
          </ul>
        </div>
        <div class="show-art show-art--capturas">
          <div class="panel-glow" style="background:linear-gradient(120deg,#34D399,#818CF8)"></div>
          <figure class="capturas">
            <div class="capturas__mac"><Captura src="/capturas/escritorio-ritmo.webp" alt="Presu en el Mac con la demo: el detalle de Mercado con su ritmo diario, la línea para cerrar en tu tope y el tope mismo" aparato="mac" ancho={640} /></div>
            <div class="capturas__iphone"><Captura src="/capturas/celular-categoria.webp" alt="Presu en el iPhone con la demo: Mercado al 100 % de su tope, con lo que deberías llevar para cerrar en él" aparato="iphone" ancho={190} /></div>
            <figcaption class="capturas__pie">Mercado en la demo: {formatCOP(mercado.gastado)} de un tope de {formatCOP(mercado.tope)}.</figcaption>
          </figure>
        </div>
      </div>

      <!-- C · Sincronización con correo -->
      <div class="show-row reveal">
        <div class="show-copy">
          <span class="eyebrow">Sin trabajo manual</span>
          <h3 data-afirma="correo-titulo">Importa solo, desde tu correo</h3>
          <p data-afirma="correo-texto">Conecta tu correo y Presu encuentra las notificaciones del banco y los extractos PDF que ya te llegaron, los lee y los importa —saltándose los duplicados. Si enciendes la IA opcional, el cuerpo del correo viaja enmascarado.</p>
          <ul class="show-list">
            <li data-afirma="correo-proveedores"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Gmail, Outlook, Yahoo e iCloud</li>
            <li data-afirma="correo-extractos"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Encuentra y procesa extractos PDF automáticamente</li>
            <li data-afirma="correo-duplicados"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Detecta duplicados para no repetir movimientos</li>
          </ul>
        </div>
        <div class="show-art show-art--capturas">
          <div class="panel-glow" style="background:linear-gradient(120deg,#818CF8,#A855F7)"></div>
          <figure class="capturas">
            <div class="capturas__mac"><Captura src="/capturas/escritorio-movimientos.webp" alt="Presu en el Mac con la demo: la lista de movimientos del día, cada uno con su banco y su categoría" aparato="mac" ancho={640} /></div>
            <div class="capturas__iphone"><Captura src="/capturas/celular-revisar.webp" alt="Presu en el iPhone con la demo: Revisar pregunta a qué cuenta fue un traslado" aparato="iphone" ancho={190} /></div>
            <figcaption class="capturas__pie">Movimientos de la demo, cada uno con su banco y su categoría.</figcaption>
          </figure>
        </div>
      </div>

    </div>

    <div class="feat-extra reveal">
      <span class="x"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 1.9 4.6L19 8.3l-3.7 3.3 1 5L12 14.5 7.7 16.6l1-5L5 8.3l5.1-.7z"/></svg><span data-afirma="extra-ia">Categorización con IA opcional, con texto enmascarado</span></span>
      <span class="x"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span data-afirma="extra-flujo">Flujo de caja y patrimonio</span></span>
      <span class="x"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg><span data-afirma="extra-exportar">Exporta a Excel o CSV</span></span>
      <span class="x"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span data-afirma="extra-multi">Multi-dispositivo</span></span>
    </div>
  </div>
</section>

<style>
  /* Tokens (aislados a esta sección — el DS v2 renombró los globales) */
  .presu-showcase{
    --indigo:#818CF8; --indigo-soft:#A5B4FC; --mint:#34D399; --mint-bright:#5EEAB8; --coral:#FB7185; --amber:#FBBF24;
    --bg-2:#101014; --bg-3:#141418; --bg-elev:#1B1B20;
    --line:rgba(255,255,255,.07); --line-2:rgba(255,255,255,.12);
    --tx:#F4F4F3; --mut:#A1A1A6; --mut2:#6B6B72;
    --radius:20px; --maxw:1160px;
    --head:"Space Grotesk",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --sh-lg:0 1px 0 rgba(255,255,255,.05) inset, 0 40px 90px -40px rgba(0,0,0,.85);
    position:relative; padding:clamp(64px,7vw,88px) 0;
  }
  .presu-showcase .wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
  .presu-showcase h2{font-family:var(--head);font-weight:700;line-height:1.1;letter-spacing:-0.03em;color:#fff;font-size:clamp(1.5rem,4vw,2rem);margin:0 0 14px}
  .presu-showcase h3{font-family:var(--head);color:#fff}
  .presu-showcase .sec-head{max-width:680px;margin:0 auto 52px;text-align:center;position:relative;z-index:2}
  .presu-showcase .eyebrow{display:inline-flex;align-items:center;gap:11px;font-family:var(--mono);font-size:.7rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--mint);margin-bottom:18px}
  .presu-showcase .eyebrow::before{content:"";width:24px;height:1.5px;background:var(--mint-bright);opacity:.6;display:inline-block}
  .presu-showcase .eyebrow.center-eb{justify-content:center}

  /* ── Feature showcase ── */
  .presu-showcase .show{display:flex;flex-direction:column;gap:88px}
  .presu-showcase .show-row{display:grid;grid-template-columns:.92fr 1.08fr;gap:56px;align-items:center}
  .presu-showcase .show-row.rev .show-copy{order:2}
  .presu-showcase .show-row.rev .show-art{order:1}
  .presu-showcase .show-copy h3{font-family:var(--head);font-weight:700;font-size:clamp(1.5rem,3vw,2.05rem);letter-spacing:-0.03em;color:#fff;margin:0 0 12px;line-height:1.1}
  .presu-showcase .show-copy>p{color:var(--mut);font-size:1.06rem;margin:0 0 18px;max-width:46ch}
  .presu-showcase .show-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:11px}
  .presu-showcase .show-list li{display:flex;gap:10px;align-items:flex-start;color:var(--tx);font-size:.97rem}
  .presu-showcase .show-list svg{color:var(--mint-bright);flex:none;margin-top:3px}
  .presu-showcase .show-art{position:relative}
  /* capturas reales: el Mac de fondo y el iPhone encima, abajo a la derecha */
  .presu-showcase .capturas{position:relative;z-index:2;margin:0;padding-bottom:28px}
  .presu-showcase .capturas__mac{width:88%}
  .presu-showcase .capturas__iphone{position:absolute;right:0;bottom:0;width:30%}
  .presu-showcase .capturas__pie{margin-top:14px;width:66%;color:var(--mut);font-size:.84rem;line-height:1.45}
  .presu-showcase .panel-glow{position:absolute;inset:-14% -10%;border-radius:50%;filter:blur(74px);opacity:.4;z-index:0}
  .presu-showcase .panel{background:linear-gradient(180deg,var(--bg-3),var(--bg-2));border:1px solid var(--line-2);border-radius:var(--radius);box-shadow:var(--sh-lg);padding:18px;position:relative;z-index:2}
  .presu-showcase .panel-cap{position:absolute;top:-11px;left:20px;z-index:3;background:rgba(52,211,153,.14);border:1px solid rgba(52,211,153,.34);color:var(--mint);font-family:var(--mono);font-size:.6rem;font-weight:500;padding:4px 10px;border-radius:999px;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}

  /* dashboard mock */
  .presu-showcase .dash-top{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:13px}
  .presu-showcase .m-chip{display:inline-flex;align-items:center;gap:6px;background:var(--bg-elev);border:1px solid var(--line);border-radius:9px;padding:6px 10px;font-size:.72rem;color:var(--mut);font-weight:500}
  .presu-showcase .m-chip .gd{width:6px;height:6px;border-radius:50%;background:var(--mint)}
  .presu-showcase .dash-date{margin-left:auto;font-size:.66rem;color:var(--mut2);font-variant-numeric:tabular-nums}
  .presu-showcase .stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}
  .presu-showcase .stat{position:relative;overflow:hidden;background:var(--bg-elev);border:1px solid var(--line);border-radius:12px;padding:12px 13px}
  .presu-showcase .spark{position:absolute;top:12px;right:12px;width:56px;height:20px;opacity:.85}
  .presu-showcase .verdict-line{background:rgba(52,211,153,.08);border:1px solid rgba(52,211,153,.22);border-radius:12px;padding:11px 14px;margin-bottom:13px}
  .presu-showcase .vl-tag{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:.58rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--mint)}
  .presu-showcase .vl-dot{width:6px;height:6px;border-radius:50%;background:var(--mint);box-shadow:0 0 7px var(--mint)}
  .presu-showcase .vl-txt{margin:6px 0 0;font-family:var(--head);font-weight:700;font-size:1rem;line-height:1.3;color:#fff}
  .presu-showcase .vl-txt b{color:var(--mint-bright)}
  .presu-showcase .stat .sl{display:flex;align-items:center;gap:6px;font-size:.7rem;color:var(--mut);font-weight:600;margin-bottom:7px}
  .presu-showcase .stat .sv{font-family:var(--head);font-weight:800;font-size:1.12rem;letter-spacing:-0.02em}
  .presu-showcase .stat .sd{font-size:.64rem;color:var(--mut2);margin-top:5px}
  .presu-showcase .budget-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:11px;font-size:.74rem}
  .presu-showcase .budget-hd .bt{font-family:var(--head);font-weight:700;color:#fff;font-size:.84rem}
  .presu-showcase .budget-hd .bn{color:var(--mut2);font-variant-numeric:tabular-nums}
  .presu-showcase .rings{display:flex;gap:10px}
  .presu-showcase .ring{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;min-width:0}
  .presu-showcase .ring .rc{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;position:relative;background:conic-gradient(var(--rc-color,var(--mint)) var(--target,0%),rgba(255,255,255,.08) 0)}
  .presu-showcase .ring .rc::after{content:"";position:absolute;inset:6px;background:var(--bg-3);border-radius:50%}
  .presu-showcase .ring .rc b{position:relative;z-index:1;font-size:.66rem;font-weight:700;color:var(--tx)}
  .presu-showcase .ring .rt{font-size:.6rem;color:var(--mut);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}

  /* chart mock */
  .presu-showcase .chart-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
  .presu-showcase .chart-hd .ct{font-family:var(--head);font-weight:700;color:#fff;font-size:.92rem}
  .presu-showcase .chart-hd .cl{font-size:.72rem;color:var(--indigo-soft);font-weight:600}
  .presu-showcase .chart-legend{display:flex;gap:16px;margin-top:10px;font-size:.68rem;color:var(--mut)}
  .presu-showcase .chart-legend span{display:inline-flex;align-items:center;gap:6px}
  .presu-showcase .chart-legend i{width:16px;height:0;border-top-width:2.5px;border-top-style:solid;display:inline-block}
  .presu-showcase .chart-pill{position:absolute;background:var(--mint);color:#06251B;font-weight:700;font-size:.74rem;padding:5px 11px;border-radius:9px;white-space:nowrap;box-shadow:0 8px 20px -8px rgba(52,211,153,.6);z-index:4}
  .presu-showcase .chart-pill::after{content:"";position:absolute;left:50%;bottom:-5px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:6px solid var(--mint)}

  /* sync mock */
  .presu-showcase .sync-hd{display:flex;align-items:center;gap:8px;font-family:var(--head);font-weight:800;font-size:.98rem;color:#fff;margin-bottom:10px}
  .presu-showcase .sync-hd svg{color:var(--indigo-soft)}
  .presu-showcase .sync-stat{background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.25);border-radius:10px;padding:9px 12px;font-size:.78rem;color:var(--indigo-soft);font-weight:600;margin-bottom:11px}
  .presu-showcase .sync-period{display:flex;gap:6px;margin-bottom:11px}
  .presu-showcase .sync-period .p{font-size:.68rem;padding:5px 9px;border-radius:8px;background:var(--bg-elev);border:1px solid var(--line);color:var(--mut2);font-weight:500}
  .presu-showcase .sync-period .p.on{background:rgba(99,102,241,.9);color:#fff;border-color:transparent}
  .presu-showcase .sync-status{display:flex;align-items:center;gap:7px;font-size:.76rem;color:var(--mint-bright);font-weight:600;margin-bottom:12px}
  .presu-showcase .sync-banks{display:flex;align-items:center;gap:7px;flex-wrap:wrap;font-size:.68rem;color:var(--mut);margin-bottom:11px}
  .presu-showcase .sync-banks .bk{background:var(--bg-elev);border:1px solid var(--line);border-radius:7px;padding:3px 8px}
  .presu-showcase .prog-row{display:flex;align-items:center;justify-content:space-between;font-size:.68rem;color:var(--mut);margin-bottom:7px}
  .presu-showcase .prog{height:5px;border-radius:4px;background:var(--bg-elev);overflow:hidden;margin-bottom:11px}
  .presu-showcase .prog>i{display:block;height:100%;width:50%;background:linear-gradient(90deg,var(--indigo),var(--mint))}
  .presu-showcase .console{background:#08080B;border:1px solid var(--line);border-radius:10px;padding:11px 13px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.68rem;line-height:1.75;color:var(--mut2);max-height:124px;overflow:hidden}
  .presu-showcase .console .dup{color:var(--amber)}
  .presu-showcase .console .imp{color:var(--mint-bright)}
  .presu-showcase .feat-extra{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:64px}
  .presu-showcase .feat-extra .x{display:inline-flex;align-items:center;gap:8px;background:var(--bg-2);border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-size:.86rem;color:var(--tx);font-weight:500}
  .presu-showcase .feat-extra .x svg{color:var(--mint-bright)}

  /* ── Ventana completa de la app (pieza "wow") ── */
  .presu-showcase .appwin{position:relative;margin:0 auto 22px;max-width:1080px}
  .presu-showcase .appwin__glow{position:absolute;inset:-6% -3% 3%;border-radius:40px;background:linear-gradient(120deg,#818CF8,#34D399);filter:blur(90px);opacity:.26;z-index:0}
  .presu-showcase .appwin__frame{position:relative;z-index:1;border:1px solid var(--line-2);border-radius:16px;overflow:hidden;background:var(--bg-2);box-shadow:var(--sh-lg)}
  .presu-showcase .appwin__bar{display:flex;align-items:center;gap:12px;padding:11px 16px;background:#0C0C10;border-bottom:1px solid var(--line)}
  .presu-showcase .appwin__dots{display:inline-flex;gap:7px}
  .presu-showcase .appwin__dots i{width:11px;height:11px;border-radius:50%;background:#3A3A42}
  .presu-showcase .appwin__dots i:nth-child(1){background:#FF5F57}
  .presu-showcase .appwin__dots i:nth-child(2){background:#FEBC2E}
  .presu-showcase .appwin__dots i:nth-child(3){background:#28C840}
  .presu-showcase .appwin__addr{font-family:var(--mono);font-size:.66rem;color:var(--mut2);letter-spacing:.04em}
  .presu-showcase .appwin__badge{margin-left:auto;display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--mint)}
  .presu-showcase .appwin__badge .gd{width:6px;height:6px;border-radius:50%;background:var(--mint);box-shadow:0 0 7px var(--mint)}
  .presu-showcase .appwin__body{display:grid;grid-template-columns:210px 1fr}
  .presu-showcase .aw-side{display:flex;flex-direction:column;gap:14px;padding:18px 14px;background:#0A0A0D;border-right:1px solid var(--line)}
  .presu-showcase .aw-brand{display:flex;flex-direction:column;gap:4px}
  .presu-showcase .aw-tag{font-family:var(--mono);font-size:.52rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mut2)}
